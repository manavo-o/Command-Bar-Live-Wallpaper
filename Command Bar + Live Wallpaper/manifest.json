{
  "manifest_version": 2,
  "name": "Command Bar + Live Wallpaper",
  "version": "1.7.0",
  "description": "Personal MV2 extension providing an Arc-style command bar overlay and a customizable live-wallpaper new-tab page with rotation, day/night scheduling, and weather/quote/focus widgets.",
  "icons": {
    "16": "icons/dot-ring-16.png",
    "32": "icons/dot-ring-32.png",
    "48": "icons/dot-ring-48.png",
    "128": "icons/dot-ring-128.png"
  },
  "browser_action": {
    "default_title": "Open Command Bar",
    "default_icon": {
      "16": "icons/dot-ring-16.png",
      "32": "icons/dot-ring-32.png"
    }
  },
  "key": "",
  "background": {
    "scripts": [
      "background/background-icon.js",
      "command-bar/command-bar-results.js",
      "background/background-site-icons.js",
      "shared/storage.js",
      "shared/search-engines.js",
      "shared/widget-layout.js",
      "shared/storage-migrations.js",
      "background/background-dictionary.js",
      "shared/focus-timer.js",
      "background/background-focus-timer.js",
      "background/background-bootstrap.js"
    ],
    "persistent": false
  },
  "web_accessible_resources": [
    "overlay-styles.css"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "k"
  },
  "commands": {
    "toggle-command-bar": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Toggle Command Bar Overlay"
    }
  },
  "permissions": [
    "tabs",
    "search",
    "sessions",
    "history",
    "bookmarks",
    "storage",
    "alarms",
    "unlimitedStorage",
    "downloads",
    "activeTab",
    "<all_urls>",
    "chrome://favicon/"
  ]
}
